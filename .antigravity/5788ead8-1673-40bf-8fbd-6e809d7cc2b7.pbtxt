        }
        lines {
          text: "    });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    links.forEach((link) => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const sNode = nodes.find((n) => n.id === link.source);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const tNode = nodes.find((n) => n.id === link.target);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      if (!sNode || !tNode) return;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const p1 = new THREE.Vector3(...sNode.position3D);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const p2 = new THREE.Vector3(...tNode.position3D);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Elevated midpoint curve"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const mid = new THREE.Vector3()"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        .addVectors(p1, p2)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        .multiplyScalar(0.5);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      mid.y += Math.max(0.6, p1.distanceTo(p2) * 0.22);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const curve = new THREE.CatmullRomCurve3(["
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        new THREE.Vector3(p1.x, p1.y + 0.5, p1.z),"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        mid,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        new THREE.Vector3(p2.x, p2.y + 0.5, p2.z)"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      ]);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const points = curve.getPoints(24);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const lineGeo = new THREE.BufferGeometry().setFromPoints(points);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const lineMesh = new THREE.Line("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        lineGeo,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        link.isSuspicious ? linkMaterialSuspicious : linkMaterialNormal"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      scene.add(lineMesh);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      // Animated glowing data packet"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const packetGeo = new THREE.SphereGeometry(link.isSuspicious ? 0.09 : 0.06, 8, 8);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      const packetMat = new THREE.MeshBasicMaterial({"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        color: link.isSuspicious ? 0xef4444 : 0x38bdf8"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      });"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
