      arguments_json: "{\"Content\":\"import React from \'react\';\\nimport { \\n  RotateCcw, \\n  Play, \\n  Pause, \\n  ZoomIn, \\n  ZoomOut, \\n  Tag, \\n  Activity, \\n  ShieldAlert, \\n  Maximize2, \\n  Minimize2, \\n  Layers, \\n  Sliders,\\n  Cpu\\n} from \'lucide-react\';\\nimport { ViewerQuality } from \'../../types\';\\n\\ninterface ViewerControlsProps {\\n  autoRotate: boolean;\\n  onToggleAutoRotate: () => void;\\n  onResetCamera: () => void;\\n  onZoomIn: () => void;\\n  onZoomOut: () => void;\\n  showLabels: boolean;\\n  onToggleLabels: () => void;\\n  showRiskOverlay: boolean;\\n  onToggleRiskOverlay: () => void;\\n  showDataFlow: boolean;\\n  onToggleDataFlow: () => void;\\n  isFullscreen: boolean;\\n  onToggleFullscreen: () => void;\\n  quality: ViewerQuality;\\n  onChangeQuality: (q: ViewerQuality) => void;\\n  is2DMode: boolean;\\n  onToggle2DMode: () => void;\\n  showDevMetrics?: boolean;\\n  onToggleDevMetrics?: () => void;\\n  fps?: number;\\n  triangleCount?: number;\\n}\\n\\nexport const ViewerControls: React.FC<ViewerControlsProps> = ({\\n  autoRotate,\\n  onToggleAutoRotate,\\n  onResetCamera,\\n  onZoomIn,\\n  onZoomOut,\\n  showLabels,\\n  onToggleLabels,\\n  showRiskOverlay,\\n  onToggleRiskOverlay,\\n  showDataFlow,\\n  onToggleDataFlow,\\n  isFullscreen,\\n  onToggleFullscreen,\\n  quality,\\n  onChangeQuality,\\n  is2DMode,\\n  onToggle2DMode,\\n  showDevMetrics,\\n  onToggleDevMetrics,\\n  fps = 60,\\n  triangleCount = 68400\\n}) => {\\n  return (\\n    <div className=\\\"absolute bottom-4 left-4 right-4 z-20 flex flex-wrap items-center justify-between gap-2 pointer-events-none\\\">\\n      {/* Left controls: 3D/2D switch & view orientation */}\\n      <div className=\\\"flex items-center gap-1.5 p-1 bg-slate-900/90 border border-slate-800 rounded-lg shadow-2xl backdrop-blur-md pointer-events-auto\\\">\\n        <button\\n          id=\\\"btn-toggle-2d-3d\\\"\\n          onClick={onToggle2DMode}\\n          className={`flex items-center gap-1.5 px-2.5 py-1.5 rounded-md text-xs font-medium transition-all ${\\n            !is2DMode \\n              ? \'bg-cyan-500/20 text-cyan-300 border border-cyan-500/40\' \\n              : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800\'\\n          }`}\\n          title=\\\"Switch between 3D Spatial Canvas and 2D Topological Map\\\"\\n          aria-label=\\\"Toggle 3D View\\\"\\n        >\\n          <Layers className=\\\"w-3.5 h-3.5\\\" />\\n          <span>{is2DMode ? \'2D Map Active\' : \'3D View\'}</span>\\n        </button>\\n\\n        <div className=\\\"h-4 w-px bg-slate-800 mx-0.5\\\" />\\n\\n        <button\\n          id=\\\"btn-reset-cam\\\"\\n          onClick={onResetCamera}\\n          className=\\\"p-1.5 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-md transition-colors\\\"\\n          title=\\\"Reset Camera Angle & Center\\\"\\n          aria-label=\\\"Reset Camera\\\"\\n        >\\n          <RotateCcw className=\\\"w-4 h-4\\\" />\\n        </button>\\n\\n        {!is2DMode && (\\n          <button\\n            id=\\\"btn-auto-rotate\\\"\\n            onClick={onToggleAutoRotate}\\n            className={`p-1.5 rounded-md transition-colors ${\\n              autoRotate \\n                ? \'text-cyan-400 bg-cyan-500/10\' \\n                : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800\'\\n            }`}\\n            title={autoRotate ? \\\"Pause Auto-Rotation\\\" : \\\"Start Auto-Rotation\\\"}\\n            aria-label=\\\"Toggle Auto Rotation\\\"\\n          >\\n            {autoRotate ? <Pause className=\\\"w-4 h-4\\\" /> : <Play className=\\\"w-4 h-4\\\" />}\\n          </button>\\n        )}\\n\\n        <button\\n          id=\\\"btn-zoom-in\\\"\\n          onClick={onZoomIn}\\n          className=\\\"p-1.5 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-md transition-colors\\\"\\n          title=\\\"Zoom In\\\"\\n          aria-label=\\\"Zoom In\\\"\\n        >\\n          <ZoomIn className=\\\"w-4 h-4\\\" />\\n        </button>\\n\\n        <button\\n          id=\\\"btn-zoom-out\\\"\\n          onClick={onZoomOut}\\n          className=\\\"p-1.5 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-md transition-colors\\\"\\n          title=\\\"Zoom Out\\\"\\n          aria-label=\\\"Zoom Out\\\"\\n        >\\n          <ZoomOut className=\\\"w-4 h-4\\\" />\\n        </button>\\n      </div>\\n\\n      {/* Middle/Right controls: Overlays & Quality */}\\n      <div className=\\\"flex items-center gap-1.5 p-1 bg-slate-900/90 border border-slate-800 rounded-lg shadow-2xl backdrop-blur-md pointer-events-auto\\\">\\n        <button\\n          id=\\\"btn-toggle-labels\\\"\\n          onClick={onToggleLabels}\\n          className={`flex items-center gap-1 px-2 py-1.5 rounded-md text-xs font-medium transition-colors ${\\n            showLabels \\n              ? \'text-cyan-300 bg-cyan-500/15 border border-cyan-500/30\' \\n              : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800\'\\n          }`}\\n          title=\\\"Toggle Asset Labels\\\"\\n          aria-label=\\\"Toggle Labels\\\"\\n        >\\n          <Tag className=\\\"w-3.5 h-3.5\\\" />\\n          <span className=\\\"hidden sm:inline\\\">Labels</span>\\n        </button>\\n\\n        <button\\n          id=\\\"btn-toggle-risk\\\"\\n          onClick={onToggleRiskOverlay}\\n          className={`flex items-center gap-1 px-2 py-1.5 rounded-md text-xs font-medium transition-colors ${\\n            showRiskOverlay \\n              ? \'text-amber-300 bg-amber-500/15 border border-amber-500/30\' \\n              : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800\'\\n          }`}\\n          title=\\\"Toggle Risk Heat Indicators\\\"\\n          aria-label=\\\"Toggle Risk Overlay\\\"\\n        >\\n          <ShieldAlert className=\\\"w-3.5 h-3.5\\\" />\\n          <span className=\\\"hidden sm:inline\\\">Risk Heat</span>\\n        </button>\\n\\n        <button\\n          id=\\\"btn-toggle-flow\\\"\\n          onClick={onToggleDataFlow}\\n          className={`flex items-center gap-1 px-2 py-1.5 rounded-md text-xs font-medium transition-colors ${\\n            showDataFlow \\n              ? \'text-emerald-300 bg-emerald-500/15 border border-emerald-500/30\' \\n              : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800\'\\n          }`}\\n          title=\\\"Toggle Live Data Flows & Threat Signals\\\"\\n          aria-label=\\\"Toggle Data Flow\\\"\\n        >\\n          <Activity className=\\\"w-3.5 h-3.5\\\" />\\n          <span className=\\\"hidden sm:inline\\\">Flows</span>\\n        </button>\\n\\n        {!is2DMode && (\\n          <div className=\\\"flex items-center gap-1 pl-1 border-l border-slate-800\\\">\\n            <Sliders className=\\\"w-3.5 h-3.5 text-slate-500 ml-1\\\" />\\n            <select\\n              id=\\\"select-quality\\\"\\n              value={quality}\\n              onChange={(e) => onChangeQuality(e.target.value as ViewerQuality)}\\n              className=\\\"bg-slate-800 text-slate-300 text-xs rounded px-1.5 py-1 border border-slate-700 outline-none focus:border-cyan-500 cursor-pointer\\\"\\n              title=\\\"Select 3D Graphics Fidelity\\\"\\n              aria-label=\\\"3D Rendering Quality\\\"\\n            >\\n              <option value=\\\"auto\\\">Auto</option>\\n              <option value=\\\"high\\\">High PBR</option>\\n              <option value=\\\"medium\\\">Medium</option>\\n              <option value=\\\"low\\\">Low Power</option>\\n            </select>\\n          </div>\\n        )}\\n\\n        {onToggleDevMetrics && (\\n          <button\\n            id=\\\"btn-toggle-metrics\\\"\\n            onClick={onToggleDevMetrics}\\n            className={`p-1.5 rounded-md transition-colors ${\\n              showDevMetrics ? \'text-cyan-400 bg-cyan-950/40\' : \'text-slate-400 hover:text-slate-200 hover:bg-slate-800\'\\n            }`}\\n            title=\\\"Toggle Technical Engine Telemetry\\\"\\n            aria-label=\\\"Toggle Engine Metrics\\\"\\n          >\\n            <Cpu className=\\\"w-3.5 h-3.5\\\" />\\n          </button>\\n        )}\\n\\n        <button\\n          id=\\\"btn-toggle-fullscreen\\\"\\n          onClick={onToggleFullscreen}\\n          className=\\\"p-1.5 text-slate-400 hover:text-slate-200 hover:bg-slate-800 rounded-md transition-colors\\\"\\n          title={isFullscreen ? \\\"Exit Fullscreen\\\" : \\\"Fullscreen 3D Viewer\\\"}\\n          aria-label=\\\"Toggle Fullscreen\\\"\\n        >\\n          {isFullscreen ? <Minimize2 className=\\\"w-4 h-4\\\" /> : <Maximize2 className=\\\"w-4 h-4\\\" />}\\n        </button>\\n      </div>\\n\\n      {/* Dev telemetry HUD if enabled */}\\n      {showDevMetrics && !is2DMode && (\\n        <div className=\\\"absolute bottom-14 left-4 p-2 bg-slate-950/90 border border-cyan-500/30 rounded-md font-mono text-[10px] text-cyan-300 space-y-0.5 backdrop-blur\\\">\\n          <div className=\\\"flex justify-between gap-4\\\">\\n            <span className=\\\"text-slate-400\\\">FPS:</span>\\n            <span className=\\\"font-semibold text-emerald-400\\\">{fps} FPS</span>\\n          </div>\\n          <div className=\\\"flex justify-between gap-4\\\">\\n            <span className=\\\"text-slate-400\\\">Triangles:</span>\\n            <span>{triangleCount.toLocaleString()}</span>\\n          </div>\\n          <div className=\\\"flex justify-between gap-4\\\">\\n            <span className=\\\"text-slate-400\\\">Pipeline:</span>\\n            <span>PBR Standard Shader</span>\\n          </div>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\",\"Overwrite\":true,\"TargetFile\":\"/src/components/three/ViewerControls.tsx\",\"toolAction\":\"Create ViewerControls.tsx\",\"toolSummary\":\"Create 3D viewer controls component\"}"
