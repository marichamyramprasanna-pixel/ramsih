        }
        lines {
          text: "      <div className=\"absolute top-3 left-4 z-10 flex items-center gap-2 text-xs text-slate-400 bg-slate-900/80 px-3 py-1.5 rounded-lg border border-slate-800 backdrop-blur\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
