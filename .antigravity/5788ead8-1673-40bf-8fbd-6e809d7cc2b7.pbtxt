        }
        lines {
          text: "  // Map 3D positions [x, y, z] to 2D SVG coordinates"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Range of x: approx -6 to +6 -> map to 80 to 920"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  // Range of z: approx -5 to +5 -> map to 60 to 540"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const get2DPos = (pos: [number, number, number]): { x: number; y: number } => {"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const x = ((pos[0] + 6) / 12) * 800 + 80;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const y = ((pos[2] + 5) / 10) * 440 + 60;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return { x, y };"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
