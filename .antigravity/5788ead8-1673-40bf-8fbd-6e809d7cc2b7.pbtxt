          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        className=\"w-full h-full min-h-[500px]\" "
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        viewBox=\"0 0 960 600\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        preserveAspectRatio=\"xMidYMid meet\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        role=\"region\""
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
