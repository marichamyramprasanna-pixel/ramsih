        lines {
          text: "      >"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        <defs>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          <linearGradient id=\"normalFlowGrad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">"
