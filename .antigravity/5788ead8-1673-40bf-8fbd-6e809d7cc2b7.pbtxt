          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    const linkMaterialSuspicious = new THREE.LineBasicMaterial({"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      color: 0xef4444,"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      transparent: true,"
