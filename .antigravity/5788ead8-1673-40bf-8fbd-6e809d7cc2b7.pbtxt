getNode && (\\n                    <button\\n                      onClick={() => {\\n                        onSelectNode(targetNode.id);\\n                        onNavigate(\'/infrastructure\');\\n                      }}\\n                      className=\\\"text-xs text-cyan-400 hover:underline flex items-center gap-1 pt-1\\\"\\n                    >\\n                      <span>Focus Asset in 3D</span>\\n                      <ArrowRight className=\\\"w-3 h-3\\\" />\\n                    </button>\\n                  )}\\n                </div>\\n              </div>\\n            </div>\\n          );\\n        })}\\n      </div>\\n    </div>\\n  );\\n};\\n\",\"Overwrite\":true,\"TargetFile\":\"/src/pages/RecommendationsPage.tsx\",\"toolAction\":\"Update RecommendationsPage.tsx\",\"toolSummary\":\"Use standard Recommendation fields in RecommendationsPage\"}"
