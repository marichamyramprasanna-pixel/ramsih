          text: "    { label: \'Top Zenith (Birds-Eye)\', azimuth: 0, elevation: 10 },"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    { label: \'Under Nadir (360\302\260 Below)\', azimuth: 180, elevation: 155 }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  ];"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
